<Window x:Class="AboEzzatReceiver.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AboEzzatReceiver.Windows"
 Title="أبو عزت ريسيفر" Icon="pack://application:,,,/Assets/aboezzat-tv-icon.ico" Width="1280" Height="800" MinWidth="900" MinHeight="600"
 Focusable="True" PreviewKeyDown="Window_PreviewKeyDown"
 WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#030C20"
 Foreground="{StaticResource TextBrush}">
 <Grid Margin="0">
  <Grid.ColumnDefinitions>
   <ColumnDefinition x:Name="InfoColumn" Width="0"/>
   <ColumnDefinition x:Name="GapColumn" Width="0"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border x:Name="MediaPanel" Grid.ColumnSpan="3" Background="#030C20" Padding="0" CornerRadius="0" MouseMove="MediaPanel_MouseMove">
   <Grid ClipToBounds="True">
    <local:VlcPlaybackPrototype x:Name="VideoPlayer" MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" Visibility="Collapsed"/>
    <Image x:Name="ReceivedImage" Stretch="Uniform" Visibility="Collapsed"/>
    <Grid x:Name="VideoOverlayLayer" Background="#02000000" MouseMove="MediaPanel_MouseMove">
     <TextBlock x:Name="SubtitleOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="30,0,30,72" Padding="8,4" TextAlignment="Center" TextWrapping="Wrap" FontSize="26" FontWeight="SemiBold" Foreground="White" Background="#99000000" IsHitTestVisible="False"/>
     <Border x:Name="PlaybackControls" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="24,0,24,18" Padding="14,10" Background="#18071328" CornerRadius="14" Visibility="Collapsed">
      <Border.Resources>
       <Style x:Key="PlayerIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F5F7FF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="Button">
           <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9"
                   Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
             <Setter TargetName="Chrome" Property="Background" Value="#263B6D"/>
             <Setter TargetName="Chrome" Property="BorderBrush" Value="#3288FF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
             <Setter TargetName="Chrome" Property="Background" Value="#2A477C"/>
             <Setter TargetName="Chrome" Property="BorderBrush" Value="#3D91FF"/>
             <Setter TargetName="Chrome" Property="Effect">
              <Setter.Value><DropShadowEffect Color="#3288FF" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/></Setter.Value>
             </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
             <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
       <Style x:Key="SeekTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
           <Border Background="{TemplateBinding Background}" Height="3" CornerRadius="2"/>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
       <Style x:Key="SeekThumb" TargetType="Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Background" Value="#2D8CFF"/>
        <Setter Property="BorderBrush" Value="#B6D9FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="Thumb">
           <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                    StrokeThickness="1">
            <Ellipse.Effect><DropShadowEffect Color="#2D8CFF" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/></Ellipse.Effect>
           </Ellipse>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
       <Style x:Key="PlayerSeekSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#2D8CFF"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="Slider">
           <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
             <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource SeekTrackButton}" Background="#2D8CFF"
                            Command="{x:Static Slider.DecreaseLarge}"/>
             </Track.DecreaseRepeatButton>
             <Track.Thumb><Thumb Style="{StaticResource SeekThumb}"/></Track.Thumb>
             <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource SeekTrackButton}" Background="#34415D"
                            Command="{x:Static Slider.IncreaseLarge}"/>
             </Track.IncreaseRepeatButton>
            </Track>
           </Grid>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
      </Border.Resources>
      <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="22"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,0,2,2">
        <TextBlock x:Name="PlaybackTimeText" Text="00:00 / 00:00" Foreground="#E9EEFF"
                   FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left"/>
        <TextBlock x:Name="DownloadStatusText" Text="" Foreground="#7DB7FF"
                   FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Right"/>
       </DockPanel>
       <Slider x:Name="SeekSlider" Grid.Row="1" Style="{StaticResource PlayerSeekSlider}"
               Minimum="0" Maximum="100" Value="0" Margin="0,0,0,2"
               IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="SeekSlider_MouseLeftButtonUp"/>
       <Grid Grid.Row="2" Margin="0,3,0,0">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
         <Button x:Name="MuteButton" Content="🔊" Click="Mute_Click" Style="{StaticResource PlayerIconButton}"
                 FontSize="18" ToolTip="كتم الصوت"/>
         <Slider x:Name="VolumeSlider" Width="92" Minimum="0" Maximum="1" Value="0.8"
                 VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Button Content="⏪ 10" Click="Back10_Click" Style="{StaticResource PlayerIconButton}" ToolTip="رجوع 10 ثوانٍ"/>
         <Button x:Name="PlayPauseButton" Content="Ⅱ" Click="PlayPause_Click"
                 Style="{StaticResource PlayerIconButton}" FontSize="27" Padding="15,6"
                 Foreground="#65B6FF" ToolTip="تشغيل أو إيقاف مؤقت"/>
         <Button Content="10 ⏩" Click="Forward10_Click" Style="{StaticResource PlayerIconButton}" ToolTip="تقديم 10 ثوانٍ"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
         <Button Content="⚙" Click="Settings_Click" Style="{StaticResource PlayerIconButton}" ToolTip="إعدادات الريسيفر"/>
         <Button x:Name="SubtitleButton" Content="CC" Click="Subtitle_Click" Style="{StaticResource PlayerIconButton}"
                 FontSize="16" ToolTip="البحث عن ترجمة عربية"/>
         <Button x:Name="DownloadButton" Content="↓" Click="DownloadCurrentMedia_Click"
                 Style="{StaticResource PlayerIconButton}" ToolTip="تنزيل ملف الفيديو المباشر"/>
         <Button x:Name="RepeatButton" Content="↻" Click="Repeat_Click"
                 Style="{StaticResource PlayerIconButton}" ToolTip="إيقاف التكرار"/>
        </StackPanel>
       </Grid>
      </Grid>
     </Border>
    </Grid>
    <Grid x:Name="WelcomePanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#030C20">
     <!-- Android uses FIT_CENTER: keep the original welcome artwork whole, anchored at the top. -->
     <Image x:Name="WelcomeBackgroundImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Margin="0,8,0,0" IsHitTestVisible="False"/>
    </Grid>
    <Grid x:Name="HomeBrandIcon" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top"
          Margin="14,12,0,0" Panel.ZIndex="40" IsHitTestVisible="False">
     <Ellipse Fill="#071022" Stroke="#FFC54A" StrokeThickness="3"/>
     <Ellipse x:Name="HomeBrandIconImage" Margin="5">
      <Ellipse.Fill>
       <ImageBrush ImageSource="pack://application:,,,/Assets/aboezzat-tv-icon.ico" Stretch="UniformToFill"/>
      </Ellipse.Fill>
     </Ellipse>
    </Grid>
    <Border x:Name="ImageControls" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,18" Padding="10,8" Background="#DD101A35" CornerRadius="12" Visibility="Collapsed">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="السابق" Click="ImagePrevious_Click" Margin="4,2" Padding="10,5" Background="#25345D" Foreground="White" BorderThickness="0"/>
      <TextBlock x:Name="ImagePositionText" Text="1 / 1" Foreground="White" VerticalAlignment="Center" Margin="8,0"/>
      <Button Content="التالي" Click="ImageNext_Click" Margin="4,2" Padding="10,5" Background="#25345D" Foreground="White" BorderThickness="0"/>
      <Button x:Name="ImageSlideshowButton" Content="تشغيل العرض" Click="ImageSlideshow_Click" Margin="4,2" Padding="10,5" Background="#238F70" Foreground="White" BorderThickness="0"/>
      <TextBlock Text="المدة" Foreground="White" VerticalAlignment="Center" Margin="8,0,4,0"/>
      <ComboBox x:Name="ImageInterval" Width="75" SelectedIndex="1" SelectionChanged="ImageInterval_SelectionChanged" VerticalAlignment="Center">
       <ComboBoxItem Content="3 ثوانٍ" Tag="3"/><ComboBoxItem Content="5 ثوانٍ" Tag="5"/><ComboBoxItem Content="10 ثوانٍ" Tag="10"/><ComboBoxItem Content="15 ثانية" Tag="15"/>
      </ComboBox>
     </StackPanel>
    </Border>
    <StackPanel x:Name="HomeQuickActions" Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="12" Panel.ZIndex="30">
     <Button Content="⚙" Width="48" Height="44" Margin="0,0,8,0" Click="Settings_Click"
             Background="#25345D" Foreground="#FFCF5E" FontSize="22" BorderThickness="0"
             ToolTip="إعدادات الريسيفر"/>
     <Button Content="🌐" Width="48" Height="44" Click="Browser_Click"
             Background="#25345D" Foreground="White" FontSize="21" BorderThickness="0"
             ToolTip="فتح المتصفح الداخلي"/>
    </StackPanel>
    <Button x:Name="FullscreenButton" Content="⛶" Width="44" Height="40"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
            Click="Fullscreen_Click" Background="#25345D" Foreground="White"
            BorderThickness="0" ToolTip="ملء الشاشة" Visibility="Collapsed"/>
    <!-- Compact Android-Receiver-style connection card: shown only on the home screen. -->
    <Border x:Name="InfoPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
            Background="#E8050C20" BorderBrush="#FFC54A" BorderThickness="1" CornerRadius="16" Padding="18,12">
     <StackPanel Width="260">
      <TextBlock Text="ABO EZZAT • RECEIVER" Foreground="#FFCF5E" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="أهلاً بك يا أبو عزت" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
      <TextBlock x:Name="ReceiverStatusText" Text="● جاري تشغيل خدمة الاستقبال..." Foreground="#FFDE97" Margin="0,6,0,0"/>
      <TextBlock x:Name="IpText" Text="جاري تحديد عنوان IP..." Foreground="#55D6D0" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="منفذ الاستقبال: 8081" Foreground="#C6CBE0" Margin="0,3,0,0"/>
      <Button x:Name="HistoryToggleButton" Content="سجل المشاهدة" Click="HistoryToggle_Click" Margin="0,12,0,6" Padding="10,7" Background="#26385F" Foreground="White" BorderThickness="0" HorizontalAlignment="Stretch"/>
      <ListBox x:Name="HistoryList" Height="190" Visibility="Collapsed" SelectionChanged="HistoryList_SelectionChanged" Background="#101A35" Foreground="#E8E9F5" BorderBrush="#34466F" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
     </StackPanel>
    </Border>
    <Button x:Name="StopButton" Content="إيقاف التشغيل" Click="Stop_Click" Visibility="Collapsed"/>
   </Grid>
  </Border>
 </Grid>
</Window>