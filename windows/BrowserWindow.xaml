<Window x:Class="AboEzzatReceiver.Windows.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="متصفح AboEzzat" Width="1180" Height="760" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#080F2B" Foreground="#E8E9F5"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#101A3B" Padding="10,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="رجوع" Click="Back_Click" IsEnabled="False"
                            Margin="0,0,0,0" Padding="12,6" Background="#25345D" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="ForwardButton" Content="تقدم" Click="Forward_Click" IsEnabled="False"
                            Margin="6,0,0,0" Padding="12,6" Background="#25345D" Foreground="White" BorderThickness="0"/>
                    <Button Content="تحديث" Click="Reload_Click" Margin="6,0,0,0" Padding="12,6"
                            Background="#25345D" Foreground="White" BorderThickness="0"/>
                    <Button Content="الرئيسية" Click="Home_Click" Margin="6,0,0,0" Padding="12,6"
                            Background="#25345D" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="إغلاق" Click="Close_Click" Padding="12,6"
                            Background="#7A3340" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                <DockPanel Margin="10,0,10,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="انتقال" Click="Go_Click" Margin="6,0,0,0"
                            Padding="14,6" Background="#238F70" Foreground="White" BorderThickness="0"/>
                    <TextBox x:Name="AddressBox" Height="34" VerticalContentAlignment="Center"
                             Padding="8,4" FlowDirection="LeftToRight" FontSize="14"
                             KeyDown="AddressBox_KeyDown" ToolTip="اكتب عنوان موقع أو كلمات للبحث"/>
                </DockPanel>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
        <Border Grid.Row="2" Background="#101A3B" Padding="8,2">
            <TextBlock x:Name="StatusText" Text="جارٍ تجهيز المتصفح..." FontSize="11"
                       Foreground="#B9C5E8" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
