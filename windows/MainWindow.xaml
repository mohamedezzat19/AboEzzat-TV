<Window x:Class="AboEzzatReceiver.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="أبو عزت ريسيفر" Width="1280" Height="800" MinWidth="900" MinHeight="600"
 WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
 Foreground="{StaticResource TextBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" LastChildFill="False">
   <TextBlock Text="أبو عزت ريسيفر" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Right"/>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Ellipse Width="8" Height="8" Fill="#55D6A5" Margin="0,0,8,0"/>
    <TextBlock Text="خدمة الاستقبال تعمل" Foreground="#BFC7E8"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,14">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="InfoColumn" Width="260"/><ColumnDefinition x:Name="GapColumn" Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="InfoPanel" Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="22">
    <StackPanel>
     <TextBlock Text="حالة الريسيفر" FontSize="23" FontWeight="Bold" Margin="0,12,0,20"/>
     <TextBlock x:Name="IpText" Text="جاري تحديد عنوان IP..." Foreground="#55D6D0" FontSize="16" TextWrapping="Wrap"/>
     <TextBlock Text="أبو عزت كاست: جاهز للاستقبال" Margin="0,22,0,0" Foreground="#C6CBE0"/>
     <TextBlock Text="منفذ الاستقبال: 8081" Margin="0,12,0,0"/>
     <TextBlock Text="اكتشاف الأجهزة: UDP 37020" Margin="0,12,0,0"/>
     <TextBlock Text="آخر المشاهدات" FontSize="18" FontWeight="Bold" Margin="0,24,0,8"/>
     <ListBox x:Name="HistoryList" Height="250" Background="#0D1634" Foreground="#E8E9F5" BorderThickness="0"
              SelectionChanged="HistoryList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
   </Border>
   <Border x:Name="MediaPanel" Grid.Column="2" Background="#0D1634" CornerRadius="18" Padding="8">
    <Grid>
     <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                   Stretch="Uniform" MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" Visibility="Collapsed"/>
     <!-- Hidden second deck for separately supplied Cast audio. -->
     <MediaElement x:Name="AudioPlayer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                   LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Visible"/>
     <Image x:Name="ReceivedImage" Stretch="Uniform" Visibility="Collapsed"/>
     <TextBlock x:Name="SubtitleOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="30,0,30,72" Padding="8,4" TextAlignment="Center" TextWrapping="Wrap" FontSize="26" FontWeight="SemiBold" Foreground="White" Background="#99000000" IsHitTestVisible="False"/>
     <Button x:Name="SubtitleButton" Content="ترجمة عربية" Click="Subtitle_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Padding="14,8" Background="#25345D" Foreground="White" BorderThickness="0" ToolTip="ابحث عن ترجمة عربية للفيديو الحالي"/>
     <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="أبو عزت ريسيفر" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock Text="جاهز لاستقبال الفيديوهات والصور من AboEzzat Cast"
                 Margin="0,14,0,0" FontSize="17" Foreground="#AEB9DC" HorizontalAlignment="Center"/>
     </StackPanel>
     <Button Content="⛶" Width="44" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
             Click="Fullscreen_Click" Background="#25345D" Foreground="White" BorderThickness="0"
             ToolTip="ملء الشاشة"/>
    </Grid>
   </Border>
  </Grid>
  <Button Grid.Row="2" x:Name="StopButton" Content="إيقاف التشغيل" Click="Stop_Click"
          Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
          HorizontalAlignment="Stretch" Margin="260,8,0,0"/>
 </Grid>
</Window>